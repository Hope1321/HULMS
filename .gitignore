# ──────────────────────────────────────────────
# HULMS — Root .gitignore
# Covers: backend (Express/Prisma) + frontend (Next.js)
# ──────────────────────────────────────────────

# ── Dependencies ───────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment / Secrets ──────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Next.js build output ───────────────────────
frontend/.next/
frontend/out/
frontend/build/

# ── TypeScript build artifacts ─────────────────
*.tsbuildinfo
frontend/next-env.d.ts

# ── Prisma generated client ────────────────────
backend/src/generated/
backend/prisma/generated/

# ── Uploads / user files ───────────────────────
backend/uploads/
backend/public/uploads/

# ── Logs ───────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── OS artifacts ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ───────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ── AI agent workspaces (local only) ───────────
.agents/
.claude/
.windsurf/
.kiro/
AGENTS.md
CLAUDE.md

# ── Testing / Coverage ─────────────────────────
coverage/
.nyc_output/

# ── Misc tooling ───────────────────────────────
.vercel
.turbo/
.cache/
dist/
*.pem

# ── Lock files (keep package-lock, ignore others) ──
# package-lock.json is kept — do NOT add it here
yarn.lock
pnpm-lock.yaml

# ── Scratch / one-off scripts ──────────────────
backend/list-users.js
backend/reset-password.js
backend/skills-lock.json
